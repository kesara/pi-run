#!/bin/sh
set -e

usage() {
  echo "Usage: $0 [-b|--build] [-h|--help]"
  echo
  echo "  -b, --build  Rebuild the pi-sandbox image before running"
  echo "  -h, --help   Show this help"
}

build=
for arg in "$@"; do
  case "$arg" in
    -b|--build) build=--build ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; usage >&2; exit 1 ;;
  esac
done

docker compose run --rm $build pi-sandbox
